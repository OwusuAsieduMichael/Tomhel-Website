NEXT_PUBLIC_SITE_URL=https://tomhel.edu.gh
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# Google Apps Script form backend (server-side only — do not prefix with NEXT_PUBLIC_)
GAS_WEB_APP_URL=
GAS_API_SECRET=

# BECE Prep portal (/prep) — Google Sheets via its own Apps Script web app. Server-side only.
# Leave PREP_GAS_URL empty in development to use the local demo file (.prep-local/data.json).
# Setup guide: docs/PREP_APPS_SCRIPT_SETUP.md
PREP_GAS_URL=
PREP_GAS_SECRET=
# Signs login cookies. 32+ random characters. Changing it signs everyone out.
PREP_SESSION_SECRET=
# Password for demo accounts created by `npm run prep:seed` (never in production)
SEED_PASSWORD=
