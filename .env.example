NEXT_PUBLIC_SITE_URL=https://tomhel.edu.gh
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# Google Apps Script form backend (server-side only — do not prefix with NEXT_PUBLIC_)
GAS_WEB_APP_URL=
GAS_API_SECRET=

# BECE Prep portal (/prep) — Google Sheets via its own Apps Script web app. Server-side only.
# Leave PREP_GAS_URL empty in development to use the local demo file (.prep-local/data.json).
# Setup guide: docs/PREP_APPS_SCRIPT_SETUP.md
PREP_GAS_URL=
PREP_GAS_SECRET=
# Signs login cookies. 32+ random characters. Changing it signs everyone out.
PREP_SESSION_SECRET=
# Password for demo accounts created by `npm run prep:seed` (never in production)
SEED_PASSWORD=

# Postgres database (Supabase "Transaction pooler" address) for the newer features. Server-side only.
# Without it those tables are Sheet tabs. Guide: docs/DATABASE.md
PREP_DATABASE_URL=

# Paystack: school fees and donations on /pay-fees and /donate. Server-side only.
# sk_test_... while testing (no real money), sk_live_... for real payments. Guide: docs/PAYMENTS.md
PAYSTACK_SECRET_KEY=
# Where Paystack sends receipts for payers who give no email (the school's accounts address).
PAYSTACK_RECEIPT_EMAIL=

# LISA, the website's assistant (Claude). Server-side only. Without it LISA is hidden. Guide: docs/LISA.md
ANTHROPIC_API_KEY=
# Most questions LISA answers per day (per running copy of the site). Default 3000.
LISA_DAILY_LIMIT=
